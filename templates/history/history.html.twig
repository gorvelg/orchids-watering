{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}

    <div class="history-list">

        {% for orchid in orchids %}

            <section class="history-card">

                <h2 class="history-card__title">
                    {{ orchid.name }}
                </h2>

                <div class="history-card__items">

                    {% for watering in orchid.waterings|slice(0, 10) %}

                        <div class="history-item">

                           <span class="history-item__date">
                                {{ watering.wateredAt|format_date(
                                    pattern='EEEE d MMMM y',
                                    locale='fr'
                                ) }}
                            </span>

                            <span class="history-item__type {{ watering.type.value }}">
                                {% include 'components/icons/' ~ watering.type.value ~ '.html.twig' %}
                                {{ watering.type.toFrench() }}
                            </span>

                        </div>

                    {% else %}

                        <p class="history-empty">
                            Aucun arrosage
                        </p>

                    {% endfor %}

                </div>

            </section>

        {% endfor %}

    </div>

{% endblock %}
